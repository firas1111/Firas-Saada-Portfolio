{
  "name": "firas-saada-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Firas Saada, software engineer (backend & integrations). Static Nuxt 4 site.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "check:sources": "node --disable-warning=ExperimentalWarning scripts/check-sources.ts",
    "check": "npm run typecheck && npm run check:sources && npm run generate",
    "images": "node --disable-warning=ExperimentalWarning scripts/render-images.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.13"
  }
}
